<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.NoticeMapper">
    <!--  내가 찜한 상태값 확인하기  -->
    <select id="subscribeNoticeSelect" parameterType="JGNoticeSubcribe" resultType="JGNoticeSubcribe">
        select * from JGNoticeSubcribe
        where JGNoticeCode = #{jGNoticeCode} AND userCode = #{userCode}
    </select>

    <!--    찜 생성하기-->
    <insert id="subscribeNoticeCreate" parameterType="JGNoticeSubcribe">
            insert into JGNoticeSubcribe(JGNoticeCode,userCode)
        value(#{jGNoticeCode}, #{userCode});
    </insert>

    <!--    찜 취소하기-->
    <delete id="subscribeNoticeDelete" parameterType="JGNoticeSubcribe">
        delete from JGNoticeSubcribe
        where JGNoticeCode = #{jGNoticeCode} and userCode = #{userCode};
    </delete>

    <!--  신고하기  -->
    <insert id="createDeclarationButton" parameterType="DeclarationDTO">
        insert into UserDeclarationA(
            noticeUserCode,
            userCode,
            userDeclarationType,
            userDeclarationOption,
            userDeclarationText,
            noticeCode,
            noticeText
        )
        value(
            #{noticeUserCode},
            #{userCode},
            #{type},
            #{arrText},
            #{singoText},
            #{noticeCode},
            #{noticeText}
        );
    </insert>

    <!--  구매하기  -->
    <insert id="saleJGNotice" parameterType="JGNotice">
        update JGNotice
        set JGNoticeSaleUserCode = #{userCode} , JGNoticeSaleBoo = #{JGNoticeSaleBoo}
        where JGNoticeCode = #{JGNoticeCode};
    </insert>

    <update id="deleteNotice" parameterType="int">
        update jgnotice
        set JGNoticeDelect = now()
        where JGNoticeCode = #{code};
    </update>




