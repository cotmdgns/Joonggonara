    <!-- @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@  -->



    <!-- @@@@@@@@@@@@@@@@@@@ 공지사항 관리 페이지 @@@@@@@@@@@@@@@@@@@  -->
    <!-- [ 괸리자 ]공지사항 조회(ALL)하기 [정상작동] -->
    <select id="adminNotificationManagementSelect" parameterType="Criteria" resultType="NotificationManagementDTO">
        select * from notificationManagement
        limit #{skip} ,#{amount};
    </select>
    <!-- [ 괸리자,일반 ]공지사항 디테일 조회하기 -->
    <select id="notificationManagementSelectDetail" parameterType="int" resultType="NotificationManagementDTO">
        select * from notificationManagement
        where notificationManagementCode = #{code}
    </select>
    <!-- [ 일반 ]공지사항 조회(ALL)하기 [정상작동] -->
    <select id="notificationManagementSelect" resultType="NotificationManagementDTO">
        select * from notificationManagement
        where notificationManagementBoo != false
    </select>
    <!-- 페이징 전용 전체 토탈 데이터 -->
    <select id="totalPage" resultType="int">
        select count(*) from notificationManagement
    </select>
    <!-- 공지사항 생성하기 -->
    <insert
        id="notificationManagementCreate"
        parameterType="NotificationManagement"
        useGeneratedKeys="true"
        keyProperty="notificationManagementCode"
    >
        insert into notificationManagement(
            userCode,
            notificationManagementTitle,
            notificationManagementText,
            notificationManagementBannerBoo,
            notificationManagementImg
        )
        value(
        #{userCode},
        #{notificationManagementTitle},
        #{notificationManagementText},
        #{notificationManagementBannerBoo},
        #{notificationManagementImg}
        );
    </insert>
    <!--  공지사항 생성 후 파일이름 추가(수정) -->
    <update id="notificationManagementImgNameUpdate" parameterType="FormDataDTO">
        Update notificationManagement
        set notificationManagementImg = #{fileName}
        where notificationManagementCode = #{code};
    </update>

    <!-- 공지사항 수정하기 -->
    <update id="notificationManagementUpdate" parameterType="NotificationManagement">
        Update notificationManagement
        set notificationManagementTitle = #{notificationManagementTitle} , notificationManagementText = #{notificationManagementText}
        where notificationManagementCode = #{notificationManagementCode};
    </update>

    <!-- 공지사항 삭제하기 -->
    <delete id="notificationManagementDelete" parameterType="int">
        Update notificationManagement
        set notificationManagementBoo = false
        where notificationManagementCode = #{code};
    </delete>
    <!-- @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@  -->



    <!-- @@@@@@@@@@@@@@@@@@@ 카테고리 관리 페이지 전용 @@@@@@@@@@@@@@@@@@@  -->
    <!--  카테고리 메이저 select문 [ 정상 작동 ] -->
    <select id="selectCategoryMajor" resultType="CategoryStateMajor">
        select categoryStateMajorCode,categoryStateMajorText
        from categoryStateMajor
    </select>

    <!--  카테고리 메이저 생성하기 [ 정상 작동 ] -->
    <insert id="CategoryMajorCreate" parameterType="String">
        insert into categoryStateMajor(categoryStateMajorText)
        value(#{str});
    </insert>
    <!--  카테고리 메이저 삭제하기 [ 정상 작동 ]  -->
    <delete id="CategoryMajorDelete" parameterType="int">
        delete from categoryStateMajor
        where categoryStateMajorCode = #{int};
    </delete>

    <!--  카테고리 메이저 수정하기 [ 정상 작동 ] -->
    <update id="CategoryMajorUpdate" parameterType="CategoryStateMajor">
        update categoryStateMajor
        set categoryStateMajorText = #{categoryStateMajorText}
        where categoryStateMajorCode = #{categoryStateMajorCode};
    </update>

    <!--  카테고리 마이너 select문 [ 정상 작동 ] -->
    <select id="SelectCategoryMinor" parameterType="int" resultType="CategoryStateMinor">
        select categoryStateMinorCode,categoryStateMinorText
        from categoryStateMinor
        where categoryStateMajorCode = ${code}
    </select>

    <!--  카테고리 마이너 생성하기  -->
    <insert id="CategoryMinorCreate" parameterType="CategoryStateMinor">
        insert into categoryStateMinor(categoryStateMajorCode,categoryStateMinorText)
        value(#{categoryStateMajorCode}, #{categoryStateMinorText});
    </insert>
    <!--  카테고리 마이너 삭제하기  -->
    <delete id="CategoryMinorDelete" parameterType="int">
        delete from categoryStateMinor
        where categoryStateMinorCode = #{int};
    </delete>
